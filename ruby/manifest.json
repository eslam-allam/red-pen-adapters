{
  "schema": 3,
  "id": "ruby",
  "name": "Ruby",
  "version": "2.1.0",
  "description": "Runs a Ruby program.",
  "author": "Red Pen",
  "icon": "data:image/svg+xml;base64,",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "rb"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "runtime": "lua",
  "command": "lua",
  "args": [
    "adapter.lua"
  ],
  "permissions": [
    "subprocess"
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The language version to install with mise, for example 22.11.0 or 3.3. It is downloaded on first use."
    },
    {
      "key": "interpreterPath",
      "label": "Runtime executable",
      "type": "path",
      "placeholder": "/usr/bin/ruby",
      "help": "The runtime that runs this language. Leave empty to use PATH."
    },
    {
      "key": "timeout",
      "label": "Seconds before stopping",
      "type": "number",
      "default": "15",
      "help": "How long the submitted program may run."
    }
  ],
  "language": "ruby",
  "bootstrap": {
    "mise": "latest"
  },
  "miseTool": "ruby",
  "runtimes": [
    {
      "tool": "ruby",
      "setting": "runtimeVersion",
      "version": "latest"
    }
  ]
}

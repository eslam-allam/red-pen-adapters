{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 4,
  "id": "julia",
  "name": "Julia",
  "version": "2.3.0",
  "description": "Runs a Julia program.",
  "author": "Red Pen",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "jl"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "language": "julia",
  "miseTool": "julia",
  "output": {
    "kinds": [
      "diff"
    ],
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "runtimes": [
    {
      "tool": "julia",
      "setting": "runtimeVersion",
      "version": "latest"
    }
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The language version to install with mise, for example 22.11.0 or 3.3. It is downloaded on first use."
    }
  ],
  "bootstrap": {
    "mise": "latest"
  },
  "icon": "data:image/svg+xml;base64,"
}
{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 3,
  "id": "logisim",
  "name": "Logisim",
  "version": "4.4.0",
  "description": "Runs Logisim's truth-table mode and compares the generated table with the key.",
  "author": "Red Pen",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "circ"
  ],
  "runtime": "lua",
  "command": "lua",
  "args": [
    "adapter.lua"
  ],
  "permissions": [
    "subprocess"
  ],
  "registry": [
    "HKCU\\Software\\JavaSoft\\Prefs"
  ],
  "keyInput": [
    {
      "key": "table",
      "label": "Key truth table",
      "type": "table",
      "required": true,
      "help": "Add at least one input and one output column. The row count follows 2 to the power of the input columns; fill every output cell.",
      "table": {
        "columns": [
          {
            "key": "inputs",
            "label": "Inputs",
            "role": "input",
            "binary": true,
            "min": 1,
            "fill": "binary"
          },
          {
            "key": "outputs",
            "label": "Outputs",
            "role": "output",
            "min": 1
          }
        ],
        "rows": {
          "count": "2 ^ inputs",
          "max": 256
        }
      }
    }
  ],
  "settings": [
    {
      "key": "programPath",
      "label": "Logisim executable",
      "type": "path",
      "required": true,
      "placeholder": "/usr/bin/logisim-evolution",
      "help": "The path to logisim-evolution or logisim."
    }
  ],
  "icon": "data:image/svg+xml;base64,",
  "appliesTo": [
    "file"
  ]
}

{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 4,
  "id": "typescript",
  "name": "TypeScript",
  "version": "2.2.0",
  "description": "Runs TypeScript with tsx.",
  "author": "Red Pen",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "ts",
    "tsx",
    "mts",
    "cts"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "language": "typescript",
  "miseTool": "bun",
  "output": {
    "kind": "diff",
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "runtimes": [
    {
      "tool": "bun",
      "setting": "runtimeVersion",
      "version": "latest"
    }
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The Bun version to install with mise, for example 1.4.4. It is downloaded on first use."
    }
  ],
  "bootstrap": {
    "mise": "latest"
  },
  "icon": "data:image/svg+xml;base64,"
}
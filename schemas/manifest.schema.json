{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eslam-allam/red-pen-adapters/main/schemas/manifest.schema.json",
  "title": "Red Pen adapter manifest",
  "description": "One adapter folder's manifest.json, as read by the Red Pen app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "extensions",
    "appliesTo",
    "output",
    "permissions",
    "keyInput",
    "settings"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "A data URI or HTTPS URL."
    },
    "homepage": {
      "type": "string",
      "format": "uri-reference"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9+.-]*$"
      }
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "file",
          "question"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinds"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "text",
              "table",
              "tableDiff",
              "diff",
              "image",
              "json"
            ]
          }
        },
        "label": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "network",
          "subprocess",
          "environment",
          "files:read",
          "files:write",
          "directories"
        ]
      },
      "uniqueItems": true
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registry": {
      "type": "array",
      "description": "Per-user registry keys the adapter needs on Windows, for example HKCU\\Software\\JavaSoft\\Prefs.",
      "items": {
        "type": "string",
        "pattern": "^(HKCU|HKEY_CURRENT_USER|HKLM|HKEY_LOCAL_MACHINE)\\\\.+$"
      },
      "uniqueItems": true
    },

{
  "schema": 2,
  "id": "erlang",
  "name": "Erlang",
  "version": "1.0.0",
  "description": "Runs an Erlang script with escript.",
  "author": "Red Pen",
  "icon": "data:image/svg+xml;base64,",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "erl"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "runtime": "process",
  "command": "uv",
  "args": [
    "run",
    "--no-project",
    "--python",
    "3.12",
    "runner.py"
  ],
  "permissions": [
    "files:read",
    "network",
    "subprocess"
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The language version to install with mise, for example 22.11.0 or 3.3. It is downloaded on first use."
    },
    {
      "key": "interpreterPath",
      "label": "Runtime executable",
      "type": "path",
      "placeholder": "/usr/bin/escript",
      "help": "The runtime that runs this language. Leave empty to use PATH."
    },
    {
      "key": "timeout",
      "label": "Seconds before stopping",
      "type": "number",
      "default": "15",
      "help": "How long the submitted program may run."
    }
  ],
  "language": "erlang",
  "bootstrap": {
    "uv": "latest",
    "mise": "latest"
  },
  "miseTool": "erlang"
}

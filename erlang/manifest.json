{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 3,
  "id": "erlang",
  "name": "Erlang",
  "version": "2.1.0",
  "description": "Runs an Erlang script with escript.",
  "author": "Red Pen",
  "icon": "data:image/svg+xml;base64,",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "erl"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "runtime": "lua",
  "command": "lua",
  "args": [
    "adapter.lua"
  ],
  "permissions": [
    "subprocess"
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The language version to install with mise, for example 22.11.0 or 3.3. It is downloaded on first use."
    }
  ],
  "language": "erlang",
  "bootstrap": {
    "mise": "latest"
  },
  "miseTool": "erlang",
  "runtimes": [
    {
      "tool": "erlang",
      "setting": "runtimeVersion",
      "version": "latest"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.builtin": {
    "basic": "enable",
    "coroutine": "enable",
    "math": "enable",
    "string": "enable",
    "table": "enable",
    "utf8": "enable",
    "debug": "disable",
    "io": "disable",
    "os": "disable",
    "package": "disable"
  },
  "workspace.library": [
    "./lua"
  ],
  "diagnostics.globals": [
    "request",
    "manifest",
    "result",
    "app"
  ]
}

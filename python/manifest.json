{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 4,
  "id": "python",
  "name": "Python",
  "version": "2.3.0",
  "description": "Runs Python code from a submitted .py file or from the answer text, and compares what it prints with the key answer.",
  "author": "Red Pen",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "py"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "output": {
    "kinds": [
      "diff"
    ],
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "runtimes": [
    {
      "tool": "python",
      "setting": "pythonVersion",
      "version": "3.12",
      "packages": {
        "setting": "packages",
        "installer": "pip"
      }
    }
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Trailing blank lines and outer whitespace are ignored."
    }
  ],
  "settings": [
    {
      "key": "pythonVersion",
      "label": "Python version",
      "type": "select",
      "options": [
        "3.10",
        "3.11",
        "3.12",
        "3.13"
      ],
      "default": "3.12",
      "help": "Red Pen downloads this Python version before the first run and keeps it in its cache."
    },
    {
      "key": "packages",
      "label": "Packages",
      "type": "textarea",
      "default": "",
      "help": "One package per line (or comma-separated), for example numpy or pandas==2.2. Red Pen installs them into a managed environment before the program runs."
    }
  ],
  "bootstrap": {
    "mise": "latest"
  },
  "icon": "data:image/svg+xml;base64,"
}
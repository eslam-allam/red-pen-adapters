{
  "$schema": "../schemas/manifest.schema.json",
  "apiVersion": 2,
  "appliesTo": [
    "file",
    "question"
  ],
  "author": "Red Pen",
  "bootstrap": {
    "mise": "latest"
  },
  "description": "Runs an F# script with dotnet fsi.",
  "extensions": [
    "fsx",
    "fs"
  ],
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "icon": "data:image/svg+xml;base64,",
  "id": "fsharp",
  "keyInput": [
    {
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored.",
      "key": "expected",
      "label": "Expected output",
      "required": true,
      "type": "textarea"
    }
  ],
  "name": "F#",
  "output": {
    "kinds": [
      "diff"
    ],
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "questionInput": [
    {
      "help": "An optional file to pass to the program as its first argument.",
      "key": "inputFile",
      "label": "Input file",
      "required": false,
      "type": "path"
    }
  ],
  "runtimes": [
    {
      "setting": "runtimeVersion",
      "tool": "dotnet",
      "version": "latest"
    }
  ],
  "schema": 5,
  "settings": [
    {
      "default": "latest",
      "help": "The runtime to install with mise. latest installs the newest supported release on first use.",
      "key": "runtimeVersion",
      "label": "Runtime version",
      "options": [
        "latest"
      ],
      "type": "select"
    }
  ],
  "version": "2.5.0"
}

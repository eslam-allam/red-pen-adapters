{
  "$schema": "../schemas/manifest.schema.json",
  "schema": 4,
  "id": "kotlin",
  "name": "Kotlin",
  "version": "2.3.0",
  "description": "Runs a Kotlin script.",
  "author": "Red Pen",
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "extensions": [
    "kt",
    "kts"
  ],
  "appliesTo": [
    "file",
    "question"
  ],
  "language": "kotlin",
  "miseTool": "kotlin",
  "output": {
    "kinds": [
      "diff"
    ],
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "runtimes": [
    {
      "tool": "kotlin",
      "setting": "runtimeVersion",
      "version": "latest"
    }
  ],
  "keyInput": [
    {
      "key": "expected",
      "label": "Expected output",
      "type": "textarea",
      "required": true,
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored."
    }
  ],
  "settings": [
    {
      "key": "runtimeVersion",
      "label": "Runtime version",
      "type": "text",
      "default": "latest",
      "placeholder": "latest",
      "help": "The language version to install with mise, for example 22.11.0 or 3.3. It is downloaded on first use."
    }
  ],
  "bootstrap": {
    "mise": "latest"
  },
  "icon": "data:image/svg+xml;base64,PHN2ZyBmaWxsPSIjN0Y1MkZGIiByb2xlPSJpbWciIHZpZXdCb3g9IjAgMCAyNCAyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48dGl0bGU+S290bGluPC90aXRsZT48cGF0aCBkPSJNMjQgMjRIMFYwaDI0TDEyIDEyWiIvPjwvc3ZnPg=="
}
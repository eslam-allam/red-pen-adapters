{
  "$schema": "../schemas/manifest.schema.json",
  "apiVersion": 2,
  "appliesTo": [
    "file",
    "question"
  ],
  "author": "Red Pen",
  "bootstrap": {
    "mise": "latest"
  },
  "description": "Runs a C# file with dotnet run --file.",
  "extensions": [
    "cs"
  ],
  "homepage": "https://github.com/eslam-allam/red-pen-adapters",
  "icon": "data:image/svg+xml;base64,",
  "id": "csharp",
  "keyInput": [
    {
      "help": "What the program should print. Outer whitespace and trailing blank lines are ignored.",
      "key": "expected",
      "label": "Expected output",
      "required": true,
      "type": "textarea"
    }
  ],
  "name": "C#",
  "output": {
    "kinds": [
      "diff"
    ],
    "label": "Program output"
  },
  "permissions": [
    "subprocess"
  ],
  "questionInput": [
    {
      "help": "An optional file to pass to the program as its first argument.",
      "key": "inputFile",
      "label": "Input file",
      "required": false,
      "type": "path"
    }
  ],
  "runtimes": [
    {
      "setting": "runtimeVersion",
      "tool": "dotnet",
      "version": "10.0"
    }
  ],
  "schema": 5,
  "settings": [
    {
      "default": "10.0",
      "help": "The .NET SDK line to install with mise. 10.0 resolves to the 10.0.4xx SDK (10.0.404 at the time of writing); 11.0 is offered for testing.",
      "key": "runtimeVersion",
      "label": "Runtime version",
      "options": [
        "10.0",
        "11.0"
      ],
      "type": "select"
    }
  ],
  "version": "2.5.0"
}
